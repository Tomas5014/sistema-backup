# Destino do backup diário da central (copie para central-backup.env,
# chmod 600). NENHUM valor real deve ficar neste arquivo de exemplo.
#
# Repositório restic — formatos:
#   local:/var/backups/macip-central-repo        (disco local do host)
#   /caminho/absoluto/repo                       (atalho local)
#   sftp:usuario@host.exemplo:/srv/backup/macip  (destino externo SFTP)
CENTRAL_BACKUP_REPOSITORY=
#
# Nome da credencial com a SENHA do repositório, resolvida pelo
# mecanismo existente (variável de ambiente ou kernel keyring
# `macip.<nome>` — grave sem argv/histórico:
#   echo -n 'senha' | keyctl padd user macip.MACIP_CENTRAL_BACKUP_PASSWORD @s
# Em ambiente systemd --user o keyring @s/@u persiste até reboot —
# regrave após reiniciar ou use EnvironmentFile na unit.
CENTRAL_BACKUP_PASSWORD_NAME=MACIP_CENTRAL_BACKUP_PASSWORD
#
# SFTP (obrigatório quando o repositório for sftp:):
#   chave privada dedicada, modo 600, SEM senha embutida aqui;
#   known_hosts com a fingerprint JÁ VERIFICADA do servidor
#   (ssh-keyscan + confirmação fora de banda, ou ssh-keygen -F).
CENTRAL_BACKUP_SFTP_KEY=
CENTRAL_BACKUP_SFTP_KNOWN_HOSTS=
# Porta SSH se não for 22 (opcional):
#CENTRAL_BACKUP_SFTP_PORT=
