# Copie para secrets/api.env — chmod 600 — fora do Git.
# Sem MACIP_API_SESSION_INSECURE_COOKIE: em HTTPS o cookie fica Secure.
MACIP_API_DATABASE_URL=postgresql+psycopg://macip_central:<SENHA-DO-POSTGRES>@db:5432/macip_central
MACIP_API_ADMIN_TOKEN=<gerar: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
