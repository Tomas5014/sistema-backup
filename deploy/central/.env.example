# Copie para deploy/central/.env e ajuste. Valores NÃO secretos apenas.
# Segredos ficam em secrets/*.env com permissão 600.

# Entrada HTTPS — loopback por padrão; mude o bind só conscientemente.
CENTRAL_BIND=127.0.0.1
CENTRAL_HTTPS_PORT=8443

# Certificados montados no proxy (ver docs/homologacao-central.md)
#CENTRAL_TLS_CERT=./tls/cert.pem
#CENTRAL_TLS_KEY=./tls/key.pem
