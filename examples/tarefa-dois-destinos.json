{
  "id": "tarefa-financeiro-dupla",
  "name": "Financeiro: rede local e MAC IP",
  "client": {
    "id": "cliente-acme",
    "name": "ACME LTDA"
  },
  "device_id": "servidor-acme-01",
  "sources": ["/dados/financeiro"],
  "exclusions": ["*.tmp", "cache/**"],
  "compression": "max",
  "timeouts": {
    "initialize_seconds": 120,
    "backup_seconds": 14400,
    "snapshots_seconds": 120,
    "check_seconds": 3600,
    "restore_seconds": 14400
  },
  "destinations": [
    {
      "id": "destino-rede-local",
      "name": "Rede local do cliente",
      "kind": "local",
      "repository": "/srv/macip-poc/cliente-acme/local",
      "password_environment": "MACIP_RESTIC_PASSWORD_LOCAL",
      "retention": {"keep_last": 14}
    },
    {
      "id": "destino-macip",
      "name": "Infraestrutura MAC IP",
      "kind": "local",
      "repository": "/srv/macip-poc/cliente-acme/macip",
      "password_environment": "MACIP_RESTIC_PASSWORD_MACIP",
      "retention": {"keep_last": 30}
    }
  ]
}
